{
  "name": "undangan-pernikahan-digital",
  "private": true,
  "version": "1.0.0",
  "description": "Web undangan pernikahan digital - mobile-first, real-time, tanpa biaya hosting",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host --port 4173",
    "placeholders": "node tools/make-placeholders.mjs",
    "check": "node tools/check-content.mjs && node tools/check-placeholders.mjs",
    "check:content": "node tools/check-content.mjs",
    "check:placeholders": "node tools/check-placeholders.mjs",
    "verify": "npm run check && npm run build"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
