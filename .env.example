# ==========================================
#  KONFIGURASI LOKAL - SALIN KE ".env"
# ==========================================
#  CARA PAKAI:
#    1. Salin file ini, ubah namanya jadi  .env
#    2. Isi nilainya
#    3. JANGAN PERNAH commit file .env  (sudah otomatis di .gitignore)
#
#  File ".env.example" ini BOLEH di-commit.
#  Isinya cuma placeholder, tidak ada rahasia.
# ==========================================


# ---------- SUPABASE (Tahap 3) ----------
# Cari di: Supabase Dashboard > Project Settings > API
#
# Format URL: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://PROJECT-ANDA.supabase.co

# Kunci "anon" / "publishable".
# AMAN ditaruh di frontend - ini bukan rahasia.
VITE_SUPABASE_ANON_KEY=paste-anon-key-anda-di-sini

# !!! JANGAN PERNAH MENGISI INI !!!
# Kunci "service_role" memberi akses PENUH ke database
# (bisa menghapus semua data). Kalau bocor, siapa pun bisa menghancurkan situs.
# Vite hanya mengirim variabel berawalan VITE_ ke browser,
# jadi kunci service_role otomatis TIDAK ikut terkirim ke client.
VITE_SUPABASE_SERVICE_ROLE_KEY=ISIKI-JIKA-TIDAK-JADI-DIPAKAI


# ---------- ANTI-SPAM (Tahap 5) ----------
# Cloudflare Turnstile - dashboard.cloudflare.com > Turnstile > Add Site
# Widget "Managed" sudah cukup, selalu tanpa label.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# ---------- SITUS (Tahap 9) ----------
# URL produksi. Dipakai untuk share link & QR code.
VITE_SITE_URL=https://undangan-contoh.vercel.app
