# ==========================================
#  KONFIGURASI LOKAL - SALIN KE ".env"
# ==========================================
#  CARA PAKAI:
#    1. Salin file ini, ubah namanya jadi  .env
#    2. Isi nilainya
#    3. JANGAN PERNAH commit file .env  (sudah otomatis di .gitignore)
#
#  File ".env.example" ini BOLEH di-commit.
#  Isinya cuma placeholder, tidak ada rahasia.
# ==========================================


# ---------- SUPABASE (Tahap 3) ----------
# Cari di: Supabase Dashboard > Project Settings > API
#
# Format URL: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://PROJECT-ANDA.supabase.co

# Kunci "anon" / "publishable".
# AMAN ditaruh di frontend - memang dirancang untuk publik.
# Akses database tetap dibatasi oleh aturan RLS di Tahap 3.
VITE_SUPABASE_ANON_KEY=paste-anon-key-anda-di-sini

# !!! KUNCI "service_role" TIDAK BOLEH ADA DI FILE INI !!!
#
# Alasannya, bukan sekadar formalitas:
#   1. project ini 100% frontend (Vite). Vite meng-inline SETIAP
#      variabel berawalan "VITE_" ke dalam bundle JavaScript yang
#      dikirim ke browser. Kalau kuncinya ada di sini, ia AKAN
#      bocor ke siapa pun yang membuka "View Source".
#   2. Kunci service_role = akses PENUH ke database, termasuk
#      menghapus semua baris. Kalau bocor, situs bisa dihancurkan
#      dan data tamu bisa disalahgunakan.
#   3. Repository ini publik, jadi histori Git tidak bisa
#      dianggap rahasia.
#
# Kuncinya hanya dipakai di sisi server (serverless function),
# dan disimpan sebagai secret platform - bukan di file .env.
# Kalau suatu saat butuh, buat file ".env.server" yang juga
# masuk .gitignore, dan jangan pernah di-prefix "VITE_".


# ---------- ANTI-SPAM (Tahap 5) ----------
# Cloudflare Turnstile - dashboard.cloudflare.com > Turnstile > Add Site
# Widget "Managed" sudah cukup, selalu tanpa label.
# Site key aman dipublikasikan; secret key TIDAK dipakai di frontend.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA


# ---------- SITUS (Tahap 9) ----------
# URL produksi. Dipakai untuk share link & QR code.
# Catatan: ini juga jadi placeholder untuk atribut og:url absolut.
VITE_SITE_URL=https://undangan-contoh.vercel.app
